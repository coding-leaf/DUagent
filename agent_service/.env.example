# EDUagent Agent Service 配置示例
# 复制为 .env 并填入实际值
#
# 无 LLM/Embedding 配置时所有 API 自动降级为规则版。
# 接入 LLM 后 enrichment / 生成 / 压缩均走 LLM 主路径。

# ---- Agent Service 基础 ----
PROJECT_NAME=EduAgent Agent Service API
VERSION=5.0
API_V1_STR=/agent/v1

# ---- LLM (对话 / 题目生成 / 语义压缩 / 解析诊断 / 画像 / 评估总结) ----
LLM_PROVIDER=agentscope_openai
LLM_BASE_URL=https://your-llm-endpoint/v1
LLM_API_KEY=sk-your-api-key
LLM_MODEL=deepseek-chat

# ---- Embedding (向量化 / 检索) ----
EMBEDDING_PROVIDER=agentscope_openai
EMBEDDING_BASE_URL=https://your-embedding-endpoint/v1
EMBEDDING_API_KEY=sk-your-api-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1024

# ---- Reranker (可选，检索精排) ----
# RERANKER_PROVIDER=openai_compatible
# RERANKER_BASE_URL=https://your-reranker-endpoint/v1
# RERANKER_API_KEY=sk-your-api-key
# RERANKER_MODEL=bge-reranker-v2-m3

# ---- Qdrant (向量数据库) ----
QDRANT_PATH=./qdrant_data
QDRANT_USER_MEMORY_COLLECTION=user_memory_v1_1024
QDRANT_COURSE_KNOWLEDGE_COLLECTION=course_knowledge_v1_1024

# ---- 高级选项 ----
# LLM_JSON_MODE_ENABLED=true
