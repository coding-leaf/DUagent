# Agent Service 应用基础信息。
PROJECT_NAME=EduAgent Agent Service API
VERSION=5.0
API_V1_STR=/agent/v1

# 本地 Qdrant 存储路径。
QDRANT_PATH=./qdrant_data

# 供 1024 维 BGE-M3 向量使用的 Qdrant collection 名称。
QDRANT_USER_MEMORY_COLLECTION=user_memory_v1_1024
QDRANT_COURSE_KNOWLEDGE_COLLECTION=course_knowledge_v1_1024
# 顶层 AI 供应商开关。当前 provider 仍走 core.ai 的可替换边界。
AI_PROVIDER=agentscope_openai

# SiliconFlow BGE-M3 嵌入服务配置。优先走 AgentScope OpenAITextEmbedding adapter。
EMBEDDING_PROVIDER=agentscope_openai
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=replace-with-real-key
EMBEDDING_DIMENSION=1024

# SiliconFlow bge-reranker-v2-m3 重排序服务配置。
RERANKER_PROVIDER=openai_compatible
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_BASE_URL=https://api.siliconflow.cn/v1
RERANKER_API_KEY=replace-with-real-key

# DeepSeek LLM 配置。优先走 AgentScope OpenAIChatModel + DeepSeekChatFormatter adapter。
LLM_PROVIDER=agentscope_openai
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=replace-with-real-key
# DeepSeek 支持 response_format: json_object，开启后要求模型输出顶层 JSON object。
LLM_JSON_MODE_ENABLED=true
# 兼容旧配置名；新配置优先使用 LLM_JSON_MODE_ENABLED。
LLM_STRUCTURED_OUTPUT_ENABLED=false
