# Agent Service 应用基础信息。
PROJECT_NAME=EduAgent Agent Service API
VERSION=5.0
API_V1_STR=/agent/v1

# 本地 Qdrant 存储路径。
QDRANT_PATH=./qdrant_data

# 供 1024 维 BGE-M3 向量使用的 Qdrant collection 名称。
QDRANT_USER_MEMORY_COLLECTION=user_memory_v1_1024
QDRANT_COURSE_KNOWLEDGE_COLLECTION=course_knowledge_v1_1024

# 顶层 AI 供应商开关。在真实 provider 接入代码前，保持为 none。
AI_PROVIDER=none

# OpenAI-compatible BGE-M3 嵌入服务配置。
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=http://localhost:8000/v1
EMBEDDING_API_KEY=replace-with-real-key
EMBEDDING_DIMENSION=1024

# OpenAI-compatible bge-reranker-v2-m3 重排序服务配置。
RERANKER_PROVIDER=openai_compatible
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_BASE_URL=http://localhost:8000/v1
RERANKER_API_KEY=replace-with-real-key

# 当前阶段 LLM 仍保持未配置状态。
LLM_PROVIDER=none
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
