APP_NAME=DUagent API
APP_VERSION=5.0
DEBUG=false

# MySQL — 替换为实际数据库密码
DATABASE_URL=mysql+aiomysql://root:PASSWORD@localhost:3306/duagent?charset=utf8mb4

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Server
HOST=0.0.0.0
PORT=8001

# Agent Service（内部通信）
AGENT_SERVICE_URL=http://localhost:8002

# LLM（用于后端侧 KG 生成）
LLM_API_KEY=sk-your-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Webhook 鉴权（与 Agent Service 共享密钥，两边保持一致）
WEBHOOK_SECRET=your-shared-secret
INTERNAL_AGENT_TOKEN=your-shared-internal-token

# Judge0
JUDGE0_API_URL=http://localhost:2358
JUDGE0_API_KEY=

# CORS（允许的前端地址）
CORS_ORIGINS=["http://localhost:8001"]
