# Copy this file to the repository root as .env.

# Database — shared by Docker Compose and Backend
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=duagent

# Infrastructure ports
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
REDIS_PORT=6379

# Backend
APP_NAME=DUagent API
APP_VERSION=5.0
DEBUG=false
JWT_SECRET_KEY=replace-with-a-long-random-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
AGENT_SERVICE_URL=http://127.0.0.1:8002
CORS_ORIGINS='["http://localhost:8001"]'

# Shared Backend / Agent authentication
WEBHOOK_SECRET=replace-with-a-shared-webhook-secret
INTERNAL_AGENT_TOKEN=replace-with-a-shared-internal-token
BACKEND_INTERNAL_BASE_URL=http://127.0.0.1:8001
BACKEND_INTERNAL_TIMEOUT=10

# Shared LLM
LLM_PROVIDER=agentscope_openai
LLM_BASE_URL=https://your-llm-endpoint/v1
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=your-chat-model
LLM_TIMEOUT=60
LLM_FORMATTER=deepseek

# Embedding and optional reranker
EMBEDDING_PROVIDER=agentscope_openai
EMBEDDING_BASE_URL=https://your-embedding-endpoint/v1
EMBEDDING_API_KEY=replace-with-your-embedding-api-key
EMBEDDING_MODEL=your-embedding-model
EMBEDDING_DIMENSION=1024
RERANKER_PROVIDER=
RERANKER_BASE_URL=
RERANKER_API_KEY=
RERANKER_MODEL=

# Qdrant and AgentScope Redis
QDRANT_API_KEY=
QDRANT_PATH=
QDRANT_COURSE_KNOWLEDGE_COLLECTION=course_knowledge_v1_1024
AGENTSCOPE_REDIS_HOST=127.0.0.1
AGENTSCOPE_REDIS_DB=0
AGENTSCOPE_REDIS_PASSWORD=

# Judge0 — the deploy script renders its private runtime config
JUDGE0_API_URL=http://127.0.0.1:2358
JUDGE0_API_KEY=
JUDGE0_POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
JUDGE0_REDIS_PASSWORD=replace-with-a-strong-redis-password
JUDGE0_WORKER_COUNT=2
JUDGE0_CPU_TIME_LIMIT=5
JUDGE0_WALL_TIME_LIMIT=15
JUDGE0_MEMORY_LIMIT=262144
JUDGE0_MAX_PROCESSES=60

# Agent optional capabilities
WEB_SEARCH_ENABLED=true
