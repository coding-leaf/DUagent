# 使用方法：
# 1. 在项目根目录执行：cp deploy/env.production.example .env
# 2. 编辑根目录 .env，替换所有 replace-with-* 和 your-* 占位值。
# 3. .env 含真实密码和密钥，已被 Git 忽略，禁止提交到仓库。
# 4. 标注“通常无需修改”的配置保持默认即可；留空表示关闭对应可选能力。

# ==================== MySQL 数据库（Docker Compose 与 Backend 共用）====================
# 通常无需修改。自动创建的 MySQL 会映射到宿主机本地地址。
DB_HOST=127.0.0.1
# MySQL 宿主机端口；仅在 3306 被占用时修改。
DB_PORT=3306
# 自动创建的新 MySQL 默认使用 root；已有数据库则填写实际用户。
DB_USER=root
# 【必填】MySQL 密码。已有 eduagent-mysql 时必须填写它当前使用的真实密码。
DB_PASSWORD=replace-with-a-strong-password
# 数据库名。全新 MySQL 会自动创建并初始化该数据库。
DB_NAME=duagent

# ==================== 基础设施端口（通常无需修改）====================
# Qdrant HTTP / gRPC 端口，以及 AgentScope Redis 端口。
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
REDIS_PORT=6379

# ==================== Backend 基础配置 ====================
# 应用名称、版本和调试模式；生产环境必须保持 DEBUG=false。
APP_NAME=DUagent API
APP_VERSION=5.0
DEBUG=false
# 【必填】JWT 签名密钥，请填写足够长的随机字符串，例如使用 openssl rand -hex 32 生成。
JWT_SECRET_KEY=replace-with-a-long-random-jwt-secret
JWT_ALGORITHM=HS256
# 登录令牌有效期，单位为分钟；10080 分钟等于 7 天。
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Backend 访问 Agent Service 的宿主机内部地址，通常无需修改。
AGENT_SERVICE_URL=http://127.0.0.1:8002
# 允许跨域的前端来源，必须是 JSON 数组；同源部署保持默认即可。
CORS_ORIGINS='["http://localhost:8001"]'

# ==================== Backend 与 Agent Service 共用鉴权 ====================
# 【必填】Webhook 共享密钥，两侧自动共用这一份值。
WEBHOOK_SECRET=replace-with-a-shared-webhook-secret
# 【必填】内部接口令牌，两侧自动共用这一份值，不需要再写第二遍。
INTERNAL_AGENT_TOKEN=replace-with-a-shared-internal-token
# Agent Service 回调 Backend 的内部地址与超时时间，通常无需修改。
BACKEND_INTERNAL_BASE_URL=http://127.0.0.1:8001
BACKEND_INTERNAL_TIMEOUT=10

# ==================== 对话大模型（Backend 与 Agent Service 共用）====================
# 使用 OpenAI 兼容接口时保持 agentscope_openai。
LLM_PROVIDER=agentscope_openai
# 【必填】模型服务的 OpenAI 兼容 API 地址，例如 https://api.deepseek.com/v1。
LLM_BASE_URL=https://your-llm-endpoint/v1
# 【必填】模型服务 API Key。
LLM_API_KEY=replace-with-your-api-key
# 【必填】实际模型标识，例如 deepseek-chat、qwen-plus 或服务商提供的模型名。
LLM_MODEL=your-chat-model
# 请求超时时间，单位为秒。
LLM_TIMEOUT=60
# DeepSeek 类接口使用 deepseek；标准 OpenAI 消息格式使用 openai。
LLM_FORMATTER=deepseek

# ==================== 向量模型与可选重排模型 ====================
# 知识库检索需要 Embedding；同样要求提供 OpenAI 兼容接口。
EMBEDDING_PROVIDER=agentscope_openai
# 【必填】Embedding API 地址。
EMBEDDING_BASE_URL=https://your-embedding-endpoint/v1
# 【必填】Embedding API Key；如果服务商允许，可与 LLM_API_KEY 相同。
EMBEDDING_API_KEY=replace-with-your-embedding-api-key
# 【必填】Embedding 模型标识。
EMBEDDING_MODEL=your-embedding-model
# 【必填】向量维度，必须与模型实际输出及 Qdrant 集合维度一致。
EMBEDDING_DIMENSION=1024
# Reranker 为可选能力；不使用时保持以下四项为空。
RERANKER_PROVIDER=
RERANKER_BASE_URL=
RERANKER_API_KEY=
RERANKER_MODEL=

# ==================== Qdrant 与 AgentScope Redis ====================
# 本机无鉴权 Qdrant 保持 API Key 和本地路径为空；部署脚本会自动注入访问地址。
QDRANT_API_KEY=
QDRANT_PATH=
# 集合名中的 1024 应与 EMBEDDING_DIMENSION 保持一致。
QDRANT_COURSE_KNOWLEDGE_COLLECTION=course_knowledge_v1_1024
# AgentScope 会话状态使用的 Redis；自动创建场景通常无需修改。
AGENTSCOPE_REDIS_HOST=127.0.0.1
AGENTSCOPE_REDIS_DB=0
# 默认 Redis 无密码，因此留空；复用带密码实例时填写实际密码。
AGENTSCOPE_REDIS_PASSWORD=

# ==================== Judge0 在线代码判题 ====================
# 自建 Judge0 默认地址；JUDGE0_API_KEY 通常留空。
JUDGE0_API_URL=http://127.0.0.1:2358
JUDGE0_API_KEY=
# 【必填】Judge0 内部 PostgreSQL 与 Redis 的独立强密码，不要与数据库密码复用。
JUDGE0_POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
JUDGE0_REDIS_PASSWORD=replace-with-a-strong-redis-password
# Worker 数量与单次判题资源限制；不了解时保持默认。
JUDGE0_WORKER_COUNT=2
# CPU 时间和总墙钟时间，单位为秒。
JUDGE0_CPU_TIME_LIMIT=5
JUDGE0_WALL_TIME_LIMIT=15
# 内存限制单位为 KB；262144 KB 等于 256 MB。
JUDGE0_MEMORY_LIMIT=262144
# 单次运行允许创建的最大进程或线程数。
JUDGE0_MAX_PROCESSES=60

# ==================== Agent 可选能力 ====================
# 是否允许 Agent 使用已配置的联网搜索工具；false 表示关闭。
WEB_SEARCH_ENABLED=true
