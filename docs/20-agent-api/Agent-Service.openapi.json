{
  "openapi": "3.0.3",
  "info": {
    "title": "EDUagent Agent-Service API",
    "version": "5.0.0",
    "description": "Backend (FastAPI, Port 8001) ↔ Agent Service (FastAPI + AgentScope, Port 8002) 内部接口规范。\n流式接口请求体使用 application/json，响应使用 SSE (text/event-stream)。\n资源生成使用 HTTP 202 + 异步 Webhook 回调。Backend 调用 Agent 前先生成 task_id 并传入请求体；Agent 返回和回调时必须原样使用该 task_id。内部链路无需额外鉴权；Agent Service 不直接写 Backend 数据库，只返回结构化结果，由 Backend 校验、落库并更新任务状态。"
  },
  "servers": [
    { "url": "http://localhost:8002/agent/v1", "description": "Agent Service 本地开发环境" }
  ],
  "paths": {
    "/tutoring/chat": {
      "post": {
        "tags": ["Tutoring"],
        "summary": "智能辅导对话",
        "description": "SSE 流式接口。Agent 每次回复前检索用户长期记忆和相关历史事实；scope=course 时使用课程知识库 RAG，scope=global 时不读取课程知识库，作为简单 AI Bot。回复可嵌入 Mermaid 图解。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TutoringChatRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SSE 事件流",
            "content": {
              "text/event-stream": {
                "schema": { "type": "string", "description": "事件类型: chunk / diagram / knowledge_points / suggestion / done" }
              }
            }
          }
        }
      }
    },
    "/profile/generate": {
      "post": {
        "tags": ["Profile"],
        "summary": "生成/刷新用户画像",
        "description": "v1 冷启动由 Frontend 固定问卷 + Backend 保存初始画像完成，Agent Service 不提供多轮冷启动引导。该接口仅用于基于学习数据（评估、练习、资源使用、近期活跃度）生成或刷新用户画像。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProfileGenerateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "example": 200 },
                    "message": { "type": "string", "example": "success" },
                    "data": { "$ref": "#/components/schemas/ProfileData" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/evaluation/generate": {
      "post": {
        "tags": ["Evaluation"],
        "summary": "生成学习效果评估",
        "description": "基于学习进度、练习结果、资源使用统计生成 3 张评估表 + LLM 文字总结",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EvaluationGenerateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "example": 200 },
                    "message": { "type": "string", "example": "success" },
                    "data": { "$ref": "#/components/schemas/EvaluationData" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/assessment/evaluate": {
      "post": {
        "tags": ["Assessment"],
        "summary": "测验评估",
        "description": "对用户提交的练习答案进行 LLM 评分和诊断，识别薄弱知识点并给出复习建议",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AssessmentEvaluateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "example": 200 },
                    "message": { "type": "string", "example": "success" },
                    "data": { "$ref": "#/components/schemas/AssessmentResult" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/assessment/generate-questions": {
      "post": {
        "tags": ["Assessment"],
        "summary": "生成题目",
        "description": "Agent Service 只生成结构化题目 JSON，不直接写 SQL。Backend 负责校验题目结构、补充 course_id / owner_user_id / source 等数据库字段，并写入 quiz_questions。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/QuestionGenerateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "example": 200 },
                    "message": { "type": "string", "example": "success" },
                    "data": { "$ref": "#/components/schemas/QuestionGenerateResult" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/learning-path/generate": {
      "post": {
        "tags": ["LearningPath"],
        "summary": "生成学习路径",
        "description": "结合学习效果评估、用户画像和静态课程知识图谱，生成个性化学习路径（节点排序+推荐）",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LearningPathGenerateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "example": 200 },
                    "message": { "type": "string", "example": "success" },
                    "data": { "$ref": "#/components/schemas/LearningPathData" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/resources/generate": {
      "post": {
        "tags": ["Resources"],
        "summary": "生成资源库",
        "description": "异步任务。Backend 先创建本地任务并把 task_id 传给 Agent；Agent 返回和回调时原样带回该 task_id。Agent 根据 course_id 从已上传并向量化的 course_knowledge 知识库检索/读取课程资料，多智能体并行生成课程级学习资料：document / mindmap / reading / code。video 为预留类型，v1 默认不生成。个性化题目由 /assessment/generate-questions 生成。完成后通过 Webhook 回调 Backend。Agent 只返回结构化资源结果，不直接写 SQL；Backend 根据 task_id 校验并幂等落库。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ResourceGenerateRequest" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "已接受，异步处理",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "example": 202 },
                    "message": { "type": "string", "example": "accepted" },
                    "data": { "$ref": "#/components/schemas/ResourceTaskResponse" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/memory/compress": {
      "post": {
        "tags": ["Memory"],
        "summary": "记忆压缩与事实提取",
        "description": "滑动窗口机制触发：融合旧摘要+新对话生成新摘要，同时提取语义事实（盲点/掌握点/偏好）。Agent Service 负责将去重后的 facts 写入 Qdrant user_memory；Backend 负责全量保存原始对话消息、消息 meta、摘要和调用结果。记忆压缩不删除、不替代原始对话。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MemoryCompressRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "example": 200 },
                    "message": { "type": "string", "example": "success" },
                    "data": { "$ref": "#/components/schemas/MemoryCompressResult" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "健康检查",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer", "example": 200 },
                    "message": { "type": "string", "example": "success" },
                    "data": { "$ref": "#/components/schemas/HealthData" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TutoringChatRequest": {
        "type": "object",
        "required": ["user_id", "message", "user_profile"],
        "properties": {
          "user_id": { "type": "string", "description": "用户 ID" },
          "scope": { "type": "string", "description": "course / global，默认 course" },
          "course_id": { "type": "string", "description": "课程 ID；scope=course 时必填，scope=global 时为空" },
          "conversation_id": { "type": "string", "description": "对话 ID（继续已有对话时传入）" },
          "message": { "type": "string", "description": "用户当前消息" },
          "user_profile": {
            "type": "object",
            "description": "用户画像（由 Backend 从 SQL 组装）。注意：Qdrant 检索由 Agent Service 自行完成",
            "required": ["guidance_level"],
            "properties": {
              "guidance_level": { "type": "string", "description": "引导粒度：L1 / L2 / L3" },
              "modal_preference": { "type": "object", "description": "模态偏好" },
              "knowledge_mastered": { "type": "array", "items": { "type": "string" }, "description": "已掌握知识点名称列表" },
              "knowledge_weak": { "type": "array", "items": { "type": "string" }, "description": "薄弱知识点名称列表" }
            }
          },
          "active_kg_nodes": {
            "type": "array",
            "items": { "type": "object" },
            "description": "当前课程绑定资源库的 Active KG 节点精简列表"
          },
          "conversation_summary": { "type": "string", "description": "全局对话摘要（记忆压缩后生成）" },
          "recent_messages": {
            "type": "array",
            "description": "最近 N 轮缓冲消息",
            "items": {
              "type": "object",
              "properties": {
                "role": { "type": "string", "description": "user / assistant" },
                "content": { "type": "string", "description": "消息内容" },
                "meta": { "type": "object", "description": "Backend 保存的消息元信息" }
              }
            }
          }
        }
      },
      "ProfileGenerateRequest": {
        "type": "object",
        "required": ["user_id", "course_id"],
        "properties": {
          "user_id": { "type": "string", "description": "用户 ID" },
          "course_id": { "type": "string", "description": "课程 ID" },
          "evaluation_data": {
            "type": "object",
            "description": "最新学习效果评估",
            "properties": {
              "progress": { "type": "object", "description": "学习进度" },
              "mastery": { "type": "object", "description": "掌握程度" },
              "resource_usage": { "type": "object", "description": "资源使用统计" }
            }
          },
          "quiz_history": {
            "type": "array",
            "description": "练习历史记录",
            "items": {
              "type": "object",
              "properties": {
                "score": { "type": "number", "description": "正确率" },
                "chapter": { "type": "string", "description": "章节" },
                "created_at": { "type": "string", "format": "date-time", "description": "完成时间" }
              }
            }
          },
          "resource_usage_stats": {
            "type": "object",
            "description": "资源类型使用比例",
            "properties": {
              "video_count": { "type": "integer", "description": "视频使用次数" },
              "document_count": { "type": "integer", "description": "文档使用次数" },
              "code_count": { "type": "integer", "description": "代码资源使用次数" },
              "quiz_count": { "type": "integer", "description": "做题次数" }
            }
          },
          "drive_intent_data": {
            "type": "object",
            "description": "近期学习频率（Backend SQL 统计）",
            "properties": {
              "recent_7d_sessions": { "type": "integer", "description": "近 7 天学习次数" },
              "recent_7d_duration": { "type": "integer", "description": "近 7 天学习时长（分钟）" }
            }
          }
        }
      },
      "ProfileData": {
        "type": "object",
        "description": "6 维用户画像",
        "properties": {
          "modal_preference": {
            "type": "object",
            "description": "模态偏好（五维雷达图）",
            "properties": {
              "video_animation": { "type": "number", "description": "视频动画偏好 0-100" },
              "chart_logic": { "type": "number", "description": "图表逻辑偏好 0-100" },
              "text_analysis": { "type": "number", "description": "文字解析偏好 0-100" },
              "code_practice": { "type": "number", "description": "代码实践偏好 0-100" },
              "formula_derivation": { "type": "number", "description": "公式推导偏好 0-100" }
            }
          },
          "guidance_level_suggestion": {
            "type": "object",
            "description": "引导粒度建议",
            "properties": {
              "recommended": { "type": "string", "description": "L1 / L2 / L3" },
              "reason": { "type": "string", "description": "建议依据" }
            }
          },
          "knowledge_coordinates": {
            "type": "array",
            "description": "知识坐标标签",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "description": "知识点名称" },
                "status": { "type": "string", "description": "mastered / learning" }
              }
            }
          },
          "cognitive_blindspots": {
            "type": "array",
            "description": "认知盲区标签",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "description": "知识点名称" },
                "error_count": { "type": "integer", "description": "错误次数" },
                "severity": { "type": "string", "description": "high / medium / low" }
              }
            }
          },
          "drive_intent": {
            "type": "object",
            "description": "驱动意图（状态光环）",
            "properties": {
              "type": { "type": "string", "description": "exam_sprint / daily_homework / casual" },
              "intensity": { "type": "number", "description": "近 7 天学习强度 0-100" }
            }
          },
          "discipline_badge": {
            "type": "object",
            "description": "学科底座徽章",
            "properties": {
              "subject": { "type": "string", "description": "学科名称" },
              "level": { "type": "string", "description": "徽章等级" },
              "streak_days": { "type": "integer", "description": "连续学习天数" }
            }
          }
        }
      },
      "EvaluationGenerateRequest": {
        "type": "object",
        "required": ["user_id", "course_id", "learning_progress", "quiz_results", "resource_usage"],
        "properties": {
          "user_id": { "type": "string", "description": "用户 ID" },
          "course_id": { "type": "string", "description": "课程 ID" },
          "learning_progress": {
            "type": "object",
            "description": "学习进度数据（Backend SQL 统计）",
            "properties": {
              "chapter_progress": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "chapter": { "type": "string", "description": "章节名称" },
                    "completion_rate": { "type": "number", "description": "完成率 0-100" },
                    "time_spent": { "type": "integer", "description": "学习时长（分钟）" }
                  }
                }
              }
            }
          },
          "quiz_results": {
            "type": "array",
            "description": "各次练习结果汇总",
            "items": {
              "type": "object",
              "properties": {
                "chapter": { "type": "string", "description": "章节" },
                "score": { "type": "number", "description": "正确率" },
                "created_at": { "type": "string", "format": "date-time", "description": "完成时间" }
              }
            }
          },
          "resource_usage": {
            "type": "object",
            "description": "资源使用统计",
            "properties": {
              "by_type": { "type": "object", "description": "{document: N, mindmap: N, reading: N, code: N, video: N}" },
              "by_chapter": { "type": "object", "description": "各章节资源使用分布" }
            }
          }
        }
      },
      "EvaluationData": {
        "type": "object",
        "properties": {
          "progress_table": {
            "type": "object",
            "description": "学习进度表",
            "properties": {
              "columns": { "type": "array", "items": { "type": "object" }, "description": "表头" },
              "rows": { "type": "array", "items": { "type": "object" }, "description": "数据行" }
            }
          },
          "mastery_table": {
            "type": "object",
            "description": "知识点掌握程度表",
            "properties": {
              "columns": { "type": "array", "items": { "type": "object" } },
              "rows": { "type": "array", "items": { "type": "object" } }
            }
          },
          "resource_usage_table": {
            "type": "object",
            "description": "资源使用习惯记录表",
            "properties": {
              "columns": { "type": "array", "items": { "type": "object" } },
              "rows": { "type": "array", "items": { "type": "object" } }
            }
          },
          "summary_text": { "type": "string", "description": "LLM 综合文字总结" }
        }
      },
      "AssessmentEvaluateRequest": {
        "type": "object",
        "required": ["user_id", "course_id", "quiz_id", "questions", "answers"],
        "properties": {
          "user_id": { "type": "string", "description": "用户 ID" },
          "course_id": { "type": "string", "description": "课程 ID" },
          "quiz_id": { "type": "string", "description": "练习 ID" },
          "questions": {
            "type": "array",
            "description": "题目列表",
            "items": {
              "type": "object",
              "required": ["id", "type", "content", "correct_answer", "knowledge_point"],
              "properties": {
                "id": { "type": "string", "description": "题目 ID" },
                "type": { "type": "string", "description": "题型" },
                "content": { "type": "string", "description": "题目内容" },
                "options": { "type": "array", "items": { "type": "object" }, "description": "选项列表" },
                "correct_answer": {
                  "description": "正确答案，单选/简答为 string，多选为 array",
                  "oneOf": [
                    { "type": "string" },
                    { "type": "array", "items": { "type": "string" } }
                  ]
                },
                "knowledge_point": { "type": "string", "description": "关联知识点" }
              }
            }
          },
          "answers": {
            "type": "array",
            "description": "用户答案",
            "items": {
              "type": "object",
              "properties": {
                "question_id": { "type": "string", "description": "题目 ID" },
                "answer": {
                  "description": "用户提交的答案，单选/简答为 string，多选为 array",
                  "oneOf": [
                    { "type": "string" },
                    { "type": "array", "items": { "type": "string" } }
                  ]
                }
              }
            }
          },
          "user_mastery": {
            "type": "object",
            "description": "用户当前知识点掌握度"
          }
        }
      },
      "QuestionGenerateRequest": {
        "type": "object",
        "required": ["user_id", "course_id"],
        "properties": {
          "user_id": { "type": "string", "description": "用户 ID" },
          "course_id": { "type": "string", "description": "课程 ID" },
          "knowledge_base_id": { "type": "string", "description": "课程知识库 ID；Backend 可由 course_id 解析后传入" },
          "chapter": { "type": "string", "description": "章节" },
          "knowledge_point": { "type": "string", "description": "知识点" },
          "question_types": {
            "type": "array",
            "items": { "type": "string" },
            "description": "single_choice / multi_choice / code / short_answer"
          },
          "count": { "type": "integer", "default": 5, "description": "生成题数" },
          "difficulty": { "type": "string", "description": "easy / medium / hard" },
          "personalized": { "type": "boolean", "default": true, "description": "是否生成个性化题" },
          "personalization_context": {
            "type": "object",
            "description": "个性化上下文",
            "properties": {
              "evaluation": { "type": "object", "description": "最近学习效果评估" },
              "profile": { "type": "object", "description": "最近用户画像" },
              "wrong_points": { "type": "array", "items": { "type": "object" }, "description": "最近错题/薄弱知识点" },
              "current_path_node": { "type": "object", "description": "当前学习路径节点" }
            }
          }
        }
      },
      "QuestionGenerateResult": {
        "type": "object",
        "properties": {
          "questions": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GeneratedQuestion" }
          }
        }
      },
      "GeneratedQuestion": {
        "type": "object",
        "required": ["type", "content", "answer", "explanation", "knowledge_point"],
        "properties": {
          "type": { "type": "string", "description": "single_choice / multi_choice / code / short_answer" },
          "content": { "type": "string", "description": "题目内容" },
          "options": {
            "type": "array",
            "description": "选项列表，非选择题为空数组",
            "items": {
              "type": "object",
              "properties": {
                "key": { "type": "string", "description": "A/B/C/D" },
                "text": { "type": "string", "description": "选项文本" }
              }
            }
          },
          "answer": { "description": "标准答案，单选/简答为 string，多选可为 array" },
          "explanation": { "type": "string", "description": "解析" },
          "chapter": { "type": "string", "description": "章节" },
          "knowledge_point": { "type": "string", "description": "关联知识点" },
          "difficulty": { "type": "string", "description": "easy / medium / hard" }
        }
      },
      "AssessmentResult": {
        "type": "object",
        "properties": {
          "per_question_results": {
            "type": "array",
            "description": "每题评估结果",
            "items": {
              "type": "object",
              "properties": {
                "question_id": { "type": "string", "description": "题目 ID" },
                "is_correct": { "type": "boolean", "description": "是否正确" },
                "explanation": { "type": "string", "description": "LLM 解析" },
                "related_knowledge_points": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "关联知识点"
                }
              }
            }
          },
          "diagnosis": {
            "type": "object",
            "description": "综合诊断",
            "properties": {
              "summary": { "type": "string", "description": "诊断总结" },
              "weak_points": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string", "description": "知识点名称" },
                    "error_pattern": { "type": "string", "description": "错误模式描述" }
                  }
                }
              },
              "suggestions": {
                "type": "array",
                "items": { "type": "string" },
                "description": "复习建议"
              }
            }
          }
        }
      },
      "LearningPathGenerateRequest": {
        "type": "object",
        "required": ["user_id", "course_id", "evaluation", "profile", "knowledge_graph"],
        "properties": {
          "user_id": { "type": "string", "description": "用户 ID" },
          "course_id": { "type": "string", "description": "课程 ID" },
          "evaluation": { "type": "object", "description": "学习效果评估数据" },
          "profile": { "type": "object", "description": "用户画像数据" },
          "knowledge_graph": {
            "type": "object",
            "description": "静态课程知识点图谱（JSON 前置依赖关系）",
            "properties": {
              "nodes": {
                "type": "array",
                "description": "图谱节点",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "chapter": { "type": "string" }
                  }
                }
              },
              "edges": {
                "type": "array",
                "description": "前置依赖边",
                "items": {
                  "type": "object",
                  "properties": {
                    "from": { "type": "string", "description": "前置节点 ID" },
                    "to": { "type": "string", "description": "后置节点 ID" }
                  }
                }
              }
            }
          }
        }
      },
      "LearningPathData": {
        "type": "object",
        "properties": {
          "nodes": {
            "type": "array",
            "description": "路径节点",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string", "description": "节点 ID" },
                "name": { "type": "string", "description": "知识点名称" },
                "status": { "type": "string", "description": "completed / in_progress / pending / recommended" },
                "mastery": { "type": "number", "description": "掌握度 0-100" },
                "order": { "type": "integer", "description": "排序序号" },
                "reason": { "type": "string", "description": "排在该位置的原因说明" }
              }
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": { "type": "string", "description": "前置节点 ID" },
                "to": { "type": "string", "description": "后置节点 ID" }
              }
            }
          },
          "current_position": {
            "type": "object",
            "properties": {
              "node_id": { "type": "string", "description": "当前节点 ID" },
              "node_name": { "type": "string", "description": "当前节点名称" }
            }
          }
        }
      },
      "ResourceGenerateRequest": {
        "type": "object",
        "required": ["task_id", "user_id", "course_id", "webhook_url"],
        "properties": {
          "task_id": { "type": "string", "description": "Backend 预先创建的任务 ID，Agent 返回和回调时原样带回" },
          "user_id": { "type": "string", "description": "触发教师用户 ID" },
          "course_id": { "type": "string", "description": "课程 ID" },
          "webhook_url": { "type": "string", "description": "完成回调 URL" },
          "chapter": { "type": "string", "description": "章节" },
          "knowledge_point": { "type": "string", "description": "知识点" },
          "resource_types": {
            "type": "array",
            "items": { "type": "string" },
            "description": "资源类型列表：document / mindmap / reading / code；不传则默认生成这四类"
          }
        }
      },
      "ResourceTaskResponse": {
        "type": "object",
        "properties": {
          "task_id": { "type": "string", "description": "Backend 传入的异步任务 ID" },
          "estimated_duration": { "type": "integer", "description": "预计完成时间（秒）" }
        }
      },
      "MemoryCompressRequest": {
        "type": "object",
        "required": ["user_id", "conversation_id", "messages_to_compress"],
        "properties": {
          "user_id": { "type": "string", "description": "用户 ID" },
          "conversation_id": { "type": "string", "description": "对话 ID" },
          "old_summary": { "type": "string", "description": "旧的全局摘要（首次压缩时为空）" },
          "messages_to_compress": {
            "type": "array",
            "description": "本轮需要压缩的对话消息（最早的 N 轮）",
            "items": {
              "type": "object",
              "properties": {
                "role": { "type": "string", "description": "user / assistant" },
                "content": { "type": "string", "description": "消息内容" },
                "timestamp": { "type": "string", "format": "date-time", "description": "消息时间" }
              }
            }
          },
          "existing_facts": {
            "type": "array",
            "items": { "type": "string" },
            "description": "已存储的长期记忆事实 ID 列表（用于去重）"
          }
        }
      },
      "MemoryCompressResult": {
        "type": "object",
        "properties": {
          "new_summary": { "type": "string", "description": "融合后的新全局摘要" },
          "extracted_facts": {
            "type": "array",
            "description": "提取的语义事实",
            "items": {
              "type": "object",
              "properties": {
                "content": { "type": "string", "description": "事实内容（如：用户在递归概念上卡壳）" },
                "fact_type": { "type": "string", "description": "blind_spot / mastered_point / cognitive_preference" },
                "knowledge_point": { "type": "string", "description": "关联知识点名称（如有）" },
                "confidence": { "type": "number", "description": "置信度 0-1" }
              }
            }
          }
        }
      },
      "HealthData": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "description": "healthy / degraded / unhealthy" },
          "qdrant_connected": { "type": "boolean", "description": "Qdrant 向量库连接状态" },
          "model_loaded": { "type": "boolean", "description": "大模型加载状态" },
          "model_name": { "type": "string", "description": "当前加载的模型名称" },
          "uptime_seconds": { "type": "integer", "description": "服务运行时长（秒）" }
        }
      }
    }
  }
}
