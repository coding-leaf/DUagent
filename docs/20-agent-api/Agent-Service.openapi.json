  "components": {
    "schemas": {
      "ChapterProgressItem": {
        "properties": {
          "chapter": {
            "type": "string",
            "title": "Chapter",
            "description": "章节名称"
          },
          "completion_rate": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Completion Rate",
            "description": "完成率 0-100"
          },
          "time_spent": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Time Spent",
            "description": "学习时长（分钟）"
          }
        },
        "type": "object",
        "required": [
          "chapter",
          "completion_rate",
          "time_spent"
        ],
        "title": "ChapterProgressItem"
      },
      "EvaluationGenerateRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id",
            "description": "用户 ID"
          },
          "course_id": {
            "type": "string",
            "title": "Course Id",
            "description": "课程 ID"
          },
          "learning_progress": {
            "$ref": "#/components/schemas/LearningProgress",
            "description": "学习进度数据（Backend SQL 统计）"
          },
          "quiz_results": {
            "items": {
              "$ref": "#/components/schemas/QuizResultItem"
            },
            "type": "array",
            "title": "Quiz Results",
            "description": "各次练习结果汇总"
          },
          "resource_usage": {
            "$ref": "#/components/schemas/ResourceUsage",
            "description": "资源使用统计"
          },
          "student_profile": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Student Profile",
            "description": "用户基础画像"
          },
          "profile_context": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Profile Context",
            "description": "Backend 规则生成的课程画像上下文"
          },
          "kg_context": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kg Context",
            "description": "课程 KG 节点与节点进度上下文"
          },
          "learning_activity": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Learning Activity",
            "description": "学习行为统计上下文"
          },
          "facts_version": {
            "type": "string",
            "title": "Facts Version",
            "description": "Backend 学习事实快照版本",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "course_id",
          "learning_progress",
          "quiz_results",
          "resource_usage"
        ],
        "title": "EvaluationGenerateRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "KGGenerationRequest": {
        "properties": {
          "context": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Context",
            "description": "The course syllabus outline context"
          },
          "catalog_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Catalog Id",
            "description": "Course catalog ID for catalog chunk input"
          },
          "source_type": {
            "type": "string",
            "title": "Source Type",
            "description": "Resource input origin",
            "default": "outline_text"
          }
        },
        "type": "object",
        "title": "KGGenerationRequest"
      },
      "KnowledgeIngestionAcceptedResponse": {
        "properties": {
          "code": {
            "type": "integer",
            "title": "Code",
            "default": 202
          },
          "message": {
            "type": "string",
            "title": "Message",
            "default": "accepted"
          },
          "data": {
            "$ref": "#/components/schemas/KnowledgeIngestionResultData"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "KnowledgeIngestionAcceptedResponse"
      },
      "KnowledgeIngestionMaterialResult": {
        "properties": {
          "storage_uri": {
            "type": "string",
            "title": "Storage Uri"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "chunk_count": {
            "type": "integer",
            "title": "Chunk Count",
            "default": 0
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "storage_uri",
          "status"
        ],
        "title": "KnowledgeIngestionMaterialResult"
      },
      "KnowledgeIngestionRequest": {
        "properties": {
          "catalog_id": {
            "type": "string",
            "title": "Catalog Id",
            "description": "课程资源目录（即 course_id）"
          },
          "materials": {
            "items": {
              "$ref": "#/components/schemas/MaterialIngestionItem"
            },
            "type": "array",
            "title": "Materials",
            "description": "待入库课本资源列表"
          }
        },
        "type": "object",
        "required": [
          "catalog_id",
          "materials"
        ],
        "title": "KnowledgeIngestionRequest"
      },
      "KnowledgeIngestionResultData": {
        "properties": {
          "catalog_id": {
            "type": "string",
            "title": "Catalog Id"
          },
          "chunk_count": {
            "type": "integer",
            "title": "Chunk Count"
          },
          "materials": {
            "items": {
              "$ref": "#/components/schemas/KnowledgeIngestionMaterialResult"
            },
            "type": "array",
            "title": "Materials"
          }
        },
        "type": "object",
        "required": [
          "catalog_id",
          "chunk_count",
          "materials"
        ],
        "title": "KnowledgeIngestionResultData"
      },
      "LearningProgress": {
        "properties": {
          "chapter_progress": {
            "items": {
              "$ref": "#/components/schemas/ChapterProgressItem"
            },
            "type": "array",
            "title": "Chapter Progress",
            "description": "各章节完成度"
          }
        },
        "type": "object",
        "required": [
          "chapter_progress"
        ],
        "title": "LearningProgress"
      },
      "MaterialIngestionItem": {
        "properties": {
          "storage_uri": {
            "type": "string",
            "title": "Storage Uri",
            "description": "课本资源的相对路径或 URI"
          }
        },
        "type": "object",
        "required": [
          "storage_uri"
        ],
        "title": "MaterialIngestionItem"
      },
      "QuizDiagnoseRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id",
            "description": "User ID"
          },
          "course_id": {
            "type": "string",
            "title": "Course Id",
            "description": "Course ID"
          },
          "quiz_id": {
            "type": "string",
            "title": "Quiz Id",
            "description": "Quiz ID"
          },
          "questions": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Questions",
            "description": "List of questions in the quiz"
          },
          "answers": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Answers",
            "description": "List of user answers submitted"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "course_id",
          "quiz_id",
          "questions",
          "answers"
        ],
        "title": "QuizDiagnoseRequest"
      },
      "QuizGenerationRequest": {
        "properties": {
          "task_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Task Id",
            "description": "Task UUID"
          },
          "course_id": {
            "type": "string",
            "title": "Course Id",
            "description": "Host entity"
          },
          "course_title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Course Title",
            "description": "Course title name to auto-inject into prompts"
          },
          "chapter": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chapter",
            "description": "Chapter"
          },
          "knowledge_point": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Knowledge Point",
            "description": "Pedagogical topic"
          },
          "question_types": {
            "items": {
              "type": "string",
              "enum": [
                "single_choice",
                "multi_choice"
              ]
            },
            "type": "array",
            "title": "Question Types"
          },
          "count": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Count",
            "default": 3
          },
          "user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Id",
            "description": "User ID for personalization"
          },
          "class_course_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Class Course Id",
            "description": "Class Course ID"
          },
          "class_course_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Class Course Ids",
            "description": "Class Course IDs"
          },
          "difficulty": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "easy",
                  "medium",
                  "hard"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Difficulty",
            "description": "Difficulty level"
          },
          "personalized": {
            "type": "boolean",
            "title": "Personalized",
            "description": "Whether this is a personalized request",
            "default": false
          },
          "personalization_context": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Personalization Context",
            "description": "Personalization context"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source",
            "description": "baseline or personalized"
          }
        },
        "type": "object",
        "required": [
          "course_id"
        ],
        "title": "QuizGenerationRequest"
      },
      "QuizResultItem": {
        "properties": {
          "chapter": {
            "type": "string",
            "title": "Chapter",
            "description": "章节"
          },
          "score": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Score",
            "description": "正确率"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At",
            "description": "完成时间"
          },
          "knowledge_point": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Knowledge Point",
            "description": "知识点名称"
          },
          "total_answers": {
