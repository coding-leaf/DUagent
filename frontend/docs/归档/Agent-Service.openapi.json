    "/agent/v1/profile/initialize": {
      "post": {
        "summary": "画像初始构建 (冷启动)",
        "deprecated": false,
        "description": "新用户首次登录，系统无其画像时，前端进入“画像初始化”引导流程",
        "tags": [],
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "user_id": {
                    "type": "string"
                  },
                  "session_id": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "recent_history": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "role": {
                          "type": "string"
                        },
                        "content": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "required": [
                  "user_id",
                  "session_id",
                  "message",
                  "recent_history"
                ]
              },
              "example": {
                "user_id": "u_123",
                "session_id": "init_999",
                "message": "我平时喜欢看视频学习，觉得指针很难。",
                "recent_history": [
                  {
                    "role": "assistant",
                    "content": "你好！为了给你提供更好的学习体验，能告诉我你平时喜欢看视频还是看文字吗？觉得C语言里哪部分最难？"
                  }
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "SSE Stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "object",
                  "properties": {}
                },
                "example": "event: message\ndata: {\"type\": \"text\", \"content\": \"好的，了解了。\"}\n\nevent: message\ndata: {\"type\": \"profile_extracted\", \"content\": {\"cognitive_blind_spots\": [\"指针\"]}}\n\nevent: done\ndata: {\"status\": \"finished\"}"
              }
            },
            "headers": {}
          }
        },
        "security": []
      }
    },
    "/agent/v1/learning-path/plan": {
      "post": {
        "summary": "个性化学习路径规划",
        "deprecated": false,
        "description": "用户进入“学习路径”页面，或完成大章节测验后请求重新规划",
        "tags": [],
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
